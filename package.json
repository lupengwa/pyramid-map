{
  "name": "pyramid-map",
  "version": "1.0.0",
  "description": "A shared, revisioned pyramid map for human and agent collaboration.",
  "license": "BSD-2-Clause",
  "repository": "https://github.com/lupengwa/pyramid-map",
  "private": true,
  "type": "module",
  "bin": {
    "pyramid-map": "bin/pyramid-map"
